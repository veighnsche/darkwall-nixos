configuration {
    font: "JetBrainsMono Nerd Font 11";
    show-icons: true;
    markup: true;
    drun-display-format: "<b>{name}</b>\n{generic}\n<span foreground='#9ca3af'>{comment}</span>\n<span foreground='#6b7280' size='smaller'>{categories}</span>";
    drun-match-fields: "name,generic,comment,categories";
    click-to-exit: true;
    eh: 4;
    fixed-num-lines: true;
    drun {
        parse-user: true;
        parse-system: false;
    }
}

* {
    background: #0d1116ff;
    foreground: #e5eaf1ff;
    selected-background: #141c2aff;
    selected-foreground: #e5eaf1ff;
    border-color: #b45309ff;
    separatorcolor: #141c2aff;

    /* Ensure alternating rows use the same readable colors */
    alternate-normal-background: #1c1c1cff;
    alternate-normal-foreground: #e5eaf1ff;
}

window {
    background-color: @background;
    border: 2;
    width: 800;
}

mainbox {
    background-color: @background;
    padding: 8;
}

inputbar {
    background-color: @background;
    text-color: @foreground;
    padding: 4 8;
    border: 0 0 1px 0;
    border-color: @border-color;
}

listview {
    background-color: @background;
    columns: 2;
    lines: 5;
    fixed-height: 0;
}

element {
    background-color: @background;
    text-color: @foreground;
    padding: 12 8;
}

element selected {
    background-color: @selected-background;
    text-color: @selected-foreground;
}

element-icon {
    size: 48;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}
